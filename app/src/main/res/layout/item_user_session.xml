<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/text_view_user_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/slate_900"
            android:textSize="16sp"
            tools:text="User-1234" />

        <TextView
            android:id="@+id/text_view_user_online"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/green_600"
            android:textSize="13sp"
            tools:text="Online" />

    </LinearLayout>

    <TextView
        android:id="@+id/text_view_user_address"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/slate_700"
        android:textSize="12sp"
        tools:text="/192.168.1.10:45678" />

    <TextView
        android:id="@+id/text_view_user_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/slate_700"
        android:textSize="13sp"
        tools:text="Stay 00:05:32 · 12 messages · Last active 00:00:12 ago" />

</LinearLayout>
